+/// Width of the menu arrow beside a status bar toggle that has one.
+const MENU_ARROW: f32 = 10.0;
+
+/// Whether the status bar toggle running `cmd` has a menu (arrow and right-click).
+fn has_menu(cmd: &str) -> bool {
+    matches!(cmd, "osnap" | "snap")
+}
+
+/// What was chosen in a status bar toggle's menu.
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum StatusMenu {
+    /// The new OSMODE.
+    Osmode(u32),
+    /// SNAPTYPE: PolarSnap (true) or Grid Snap.
+    SnapType(bool),
+    /// Drafting Settings.
+    Settings,
+}
+
+/// The Object Snap menu: every running snap with a check mark, then the settings. Checking a
+/// snap also turns Object Snap on, as AutoCAD does; the menu stays open to pick several.
+fn osnap_menu(ui: &mut egui::Ui, s: &cadcraft_engine::Settings) -> Option<StatusMenu> {
+    use cadcraft_engine::snap::mode;
+    let mut picked = None;
+    for (bit, name) in mode::ALL {
+        let mut checked = s.osmode & bit != 0;
+        if ui.checkbox(&mut checked, crate::i18n::t(name)).clicked() {
+            picked = Some(StatusMenu::Osmode(if checked { (s.osmode | bit) & !mode::OFF } else { s.osmode & !bit }));
+        }
+    }
+    ui.separator();
+    if ui.button(crate::tl!("Object Snap Settings...")).clicked() {
+        picked = Some(StatusMenu::Settings);
+        ui.close();
+    }
+    picked
+}
+
+/// The Snap Mode menu: PolarSnap or Grid Snap (either turns Snap on), then the settings.
+fn snap_menu(ui: &mut egui::Ui, s: &cadcraft_engine::Settings) -> Option<StatusMenu> {
+    let mut picked = None;
+    for (polar, label) in [(true, "PolarSnap"), (false, "Grid snap")] {
+        if ui.radio(s.snapmode && s.polarsnap == polar, crate::i18n::t(label)).clicked() {
+            picked = Some(StatusMenu::SnapType(polar));
+            ui.close();
+        }
+    }
+    ui.separator();
+    if ui.button(crate::tl!("Snap Settings...")).clicked() {
+        picked = Some(StatusMenu::Settings);
+        ui.close();
+    }
+    picked
+}
+
