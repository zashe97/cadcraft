+/// The distance from `cursor` to the closest point of `p` (infinite when it has no curve).
+fn prim_distance(p: &Prim, cursor: Vec2) -> f64 {
+    let curve = prim_segments(p).iter().map(|s| fix_circle(s).closest(cursor).dist(cursor)).fold(f64::INFINITY, f64::min);
+    match p {
+        Prim::Circle(c) => curve.min(c.closest(cursor).dist(cursor)),
+        _ => curve,
+    }
+}
+
 fn snap_score(mode: u32, point: Vec2, cursor: Vec2, aperture: f64) -> f64 {
     point.dist(cursor) - if mode == mode::INT || mode == mode::END { aperture * 0.15 } else { 0.0 }
 }
