diff --git a/crates/ui-egui/tests/status_bar_osnap_menu.rs b/crates/ui-egui/tests/status_bar_osnap_menu.rs
new file mode 100644
index 0000000..9295288
--- /dev/null
+++ b/crates/ui-egui/tests/status_bar_osnap_menu.rs
@@ -0,0 +1,153 @@
+//! The Object Snap and Snap Mode buttons on the status bar have AutoCAD's menu: the arrow beside
+//! the button, or a right-click on it, lists the running snaps to check and the settings; a snap
+//! checked there then finds the geometry of the other objects under the cursor.
+
+use cadcraft_engine::Session;
+use cadcraft_engine::doc::{Common, Drawing, EntityKind, Line, Space};
+use cadcraft_engine::geom::Vec2;
+use cadcraft_engine::snap::mode;
+use cadcraft_ui_egui::{CadApp, Services};
+use egui::{Event, Modifiers, PointerButton, Pos2, vec2};
+use egui_kittest::Harness;
+use egui_kittest::kittest::Queryable;
+use serde_json::json;
+
+fn harness() -> Harness<'static, CadApp> {
+    let mut d = Drawing::new_imperial();
+    for (a, b) in [(Vec2::new(0.0, 0.0), Vec2::new(20.0, 0.0)), (Vec2::new(0.0, 10.0), Vec2::new(20.0, 10.0))] {
+        d.add(&Space::Model, Common::default(), EntityKind::Line(Line { a: a.to3(0.0), b: b.to3(0.0) })).unwrap();
+    }
+    let mut session = Session::empty();
+    session.open_drawing(d, "Status bar osnap menu", None);
+    session.execute("view.set", &json!({"center":[10,5],"height":30})).unwrap();
+    let mut app = CadApp::new(session, Services::default());
+    app.canvas.zoom_pending = false;
+    let mut h = Harness::builder().with_size(vec2(1600.0, 1000.0)).build_ui_state(
+        |ui, app: &mut CadApp| {
+            app.logic(ui.ctx());
+            app.ui(ui);
+        },
+        app,
+    );
+    h.run_steps(5);
+    h
+}
+
+/// Click the menu's check box for a snap (the canvas's own menus may hold the same label).
+fn check(h: &Harness<'_, CadApp>, name: &str) {
+    h.get_by_role_and_label(egui::accesskit::Role::CheckBox, name).click();
+}
+
+fn osmode(h: &Harness<'_, CadApp>) -> u32 {
+    h.state().session.settings.osmode
+}
+
+fn hover(h: &mut Harness<'_, CadApp>, point: Vec2) -> Pos2 {
+    let pos = h.state().canvas.xf.unwrap().to_screen(point) + vec2(3.0, 2.0);
+    h.event(Event::PointerMoved(pos));
+    h.run_steps(3);
+    pos
+}
+
+fn click(h: &mut Harness<'_, CadApp>, pos: Pos2) {
+    for pressed in [true, false] {
+        h.event(Event::PointerButton { pos, button: PointerButton::Primary, pressed, modifiers: Modifiers::NONE });
+        h.run_steps(2);
+    }
+}
+
+#[test]
+fn the_arrow_menu_checks_snaps_that_then_find_other_objects() {
+    let mut h = harness();
+    // AutoCAD's default running snaps: Endpoint, Center, Intersection, Extension; no Midpoint.
+    assert_eq!(osmode(&h), mode::END | mode::CEN | mode::INT | mode::EXT);
+    h.get_by_label("Object Snap menu").click();
+    h.run_steps(2);
+    check(&h, "Midpoint");
+    h.run_steps(2);
+    // The menu stays open, so a second snap can be checked straight away.
+    check(&h, "Perpendicular");
+    h.run_steps(2);
+    assert_eq!(osmode(&h), mode::END | mode::CEN | mode::INT | mode::EXT | mode::MID | mode::PER);
+    h.key_press(egui::Key::Escape);
+    h.run_steps(2);
+
+    // LINE from the midpoint of the lower line, perpendicular to the upper one.
+    h.state_mut().start("line");
+    h.run_steps(2);
+    let pos = hover(&mut h, Vec2::new(10.0, 0.0));
+    let hit = h.state().canvas.snap.expect("midpoint marker");
+    assert_eq!(hit.mode, mode::MID);
+    assert!(hit.point.near(Vec2::new(10.0, 0.0), 1e-6));
+    click(&mut h, pos);
+    let pos = hover(&mut h, Vec2::new(10.4, 10.0));
+    let hit = h.state().canvas.snap.expect("perpendicular marker");
+    assert_eq!(hit.mode, mode::PER);
+    assert!(hit.point.near(Vec2::new(10.0, 10.0), 1e-6));
+    click(&mut h, pos);
+    let st = h.state().session.state().unwrap();
+    let line = st.doc.space(&Space::Model).unwrap().iter().find_map(|e| match &e.kind {
+        EntityKind::Line(l) if l.a.xy().near(Vec2::new(10.0, 0.0), 1e-6) => Some((l.a.xy(), l.b.xy())),
+        _ => None,
+    });
+    let (_, b) = line.expect("the new line starts at the midpoint");
+    assert!(b.near(Vec2::new(10.0, 10.0), 1e-6), "{b:?}");
+}
+
+#[test]
+fn a_right_click_on_the_button_opens_the_same_menu_and_unchecks() {
+    let mut h = harness();
+    h.get_by_label("Object Snap (F3)").click_secondary();
+    h.run_steps(2);
+    check(&h, "Endpoint");
+    h.run_steps(2);
+    assert_eq!(osmode(&h) & mode::END, 0);
+    assert_ne!(osmode(&h) & mode::CEN, 0);
+}
+
+#[test]
+fn checking_a_snap_while_object_snap_is_off_turns_it_on() {
+    let mut h = harness();
+    h.state_mut().session.settings.osmode |= mode::OFF;
+    h.run_steps(2);
+    h.get_by_label("Object Snap menu").click();
+    h.run_steps(2);
+    check(&h, "Nearest");
+    h.run_steps(2);
+    assert_eq!(osmode(&h) & mode::OFF, 0);
+    assert_ne!(osmode(&h) & mode::NEA, 0);
+}
+
+#[test]
+fn the_settings_item_and_a_button_with_no_snaps_open_drafting_settings() {
+    let mut h = harness();
+    h.get_by_label("Object Snap menu").click();
+    h.run_steps(2);
+    h.get_by_label("Object Snap Settings...").click();
+    h.run_steps(3);
+    assert_eq!(h.state().ui.dialog.as_deref(), Some("dsettings"));
+    h.state_mut().ui.dialog = None;
+    h.state_mut().session.settings.osmode = 0;
+    h.run_steps(2);
+    h.get_by_label("Object Snap (F3)").click();
+    h.run_steps(3);
+    assert_eq!(h.state().ui.dialog.as_deref(), Some("dsettings"));
+}
+
+#[test]
+fn the_snap_mode_menu_picks_polar_or_grid_snap_and_turns_snap_on() {
+    let mut h = harness();
+    assert!(!h.state().session.settings.snapmode);
+    h.get_by_label("Snap Mode menu").click();
+    h.run_steps(2);
+    h.get_by_label("PolarSnap").click();
+    h.run_steps(2);
+    assert!(h.state().session.settings.snapmode);
+    assert!(h.state().session.settings.polarsnap);
+    h.get_by_label("Snap Mode menu").click();
+    h.run_steps(2);
+    h.get_by_label("Grid snap").click();
+    h.run_steps(2);
+    assert!(h.state().session.settings.snapmode);
+    assert!(!h.state().session.settings.polarsnap);
+}
